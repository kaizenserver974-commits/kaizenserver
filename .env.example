# Facultatif : sans clé, Kaizen fonctionne avec son moteur de règles.
OPENAI_API_KEY=
# Facultatif : modèle utilisé (par défaut gpt-5-mini)
OPENAI_MODEL=
# Facultatif : adresse e-mail qui reçoit les demandes (bouton « Envoyer ma demande »)
NEXT_PUBLIC_KAIZEN_EMAIL=
# Commandes : envoi par e-mail via Resend (https://resend.com)
RESEND_API_KEY=
# Adresse qui reçoit les commandes
KAIZEN_EMAIL=
# Expéditeur vérifié dans Resend (sinon onboarding@resend.dev, limité aux tests)
KAIZEN_EMAIL_FROM=
# Espace client (connexion, commandes, devis, messages) et espace équipe : Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé serveur (jamais dans une variable NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=
# Adresses de l'équipe autorisées sur /admin (séparées par des virgules)
KAIZEN_ADMIN_EMAILS=
# Adresse publique du site (liens dans les e-mails), ex. https://kaizenserver.fr
NEXT_PUBLIC_SITE_URL=
# Paiement en ligne Mollie (clé du profil KaizenServer : test_… puis live_…)
MOLLIE_API_KEY=
